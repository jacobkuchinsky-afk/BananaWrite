# --- Chutes AI Configuration (commented out) ---
# CHUTES_API_KEY=
# CHUTES_BASE_URL=https://llm.chutes.ai/v1

# --- Anthropic API Configuration ---
# Generate with: claude setup-token (requires Claude Max subscription)
# This is an OAuth token, passed via auth_token (Bearer header), not x-api-key
ANTHROPIC_AUTH_TOKEN=

# CORS Configuration (comma-separated list of allowed origins)
# Add your Vercel domain here after deployment
CORS_ALLOWED_ORIGINS=https://bananawrite.vercel.app

# Copy this file to .env and fill in your values

