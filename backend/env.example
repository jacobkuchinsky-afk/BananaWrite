# --- Chutes AI Configuration (commented out) ---
# CHUTES_API_KEY=
# CHUTES_BASE_URL=https://llm.chutes.ai/v1

# --- Claude Max API Proxy Configuration ---
# The proxy runs inside the container (started by start.sh).
# These are only needed if you want to override the defaults.
# CLAUDE_PROXY_API_KEY=not-needed
# CLAUDE_PROXY_BASE_URL=http://localhost:3456/v1

# --- Claude Code CLI Authentication (required on Railway) ---
# Generate token with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=
# Get these from: cat ~/.claude.json
CLAUDE_ACCOUNT_UUID=
CLAUDE_EMAIL=
CLAUDE_ORG_UUID=

# CORS Configuration (comma-separated list of allowed origins)
# Add your Vercel domain here after deployment
CORS_ALLOWED_ORIGINS=https://bananawrite.vercel.app

# Copy this file to .env and fill in your values

